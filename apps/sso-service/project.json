{
  "name": "sso-service",
  "projectType": "application",
  "sourceRoot": "apps/sso-service",
  "tags": ["scope:auth", "type:go-service"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["go-source"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "apps/sso-service",
        "command": "go build -o dist/sso-service ./cmd/server"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/sso-service",
        "command": "go run ./cmd/server"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["go-source"],
      "options": {
        "cwd": "apps/sso-service",
        "command": "go test ./..."
      },
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["go-source"],
      "options": {
        "cwd": "apps/sso-service",
        "command": "golangci-lint run"
      },
      "cache": true
    }
  }
}
