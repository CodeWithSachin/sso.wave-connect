{
  "name": "sso-service",
  "projectType": "application",
  "sourceRoot": "apps/sso-service",
  "tags": ["scope:auth", "type:go-service"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["go-source"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "apps/sso-service",
        "command": "go build -o dist/sso-service ./cmd/server"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/sso-service",
        "command": "go run ./cmd/server"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": ["go-source"],
      "options": {
        "cwd": "apps/sso-service",
        "command": "go test ./..."
      },
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": ["go-source"],
      "options": {
        "cwd": "apps/sso-service",
        "command": "golangci-lint run"
      },
      "cache": true
    },
    "openapi:export": {
      "executor": "nx:run-commands",
      "inputs": [
        "go-source",
        {
          "runtime": "swag --version"
        }
      ],
      "cache": true,
      "options": {
        "cwd": "apps/sso-service",
        "commands": [
          "swag init -g cmd/server/main.go -o internal/openapi --parseDependency --parseInternal",
          "rm -f internal/openapi/docs.go",
          "mkdir -p ../../docs/api/sso-service",
          "cp internal/openapi/swagger.json ../../docs/api/sso-service/openapi.json",
          "cp internal/openapi/swagger.yaml ../../docs/api/sso-service/openapi.yaml"
        ],
        "parallel": false
      },
      "outputs": [
        "{projectRoot}/internal/openapi/swagger.json",
        "{projectRoot}/internal/openapi/swagger.yaml",
        "{workspaceRoot}/docs/api/sso-service"
      ]
    }
  }
}
