{
    "swagger": "2.0",
    "info": {
        "description": "OAuth2 / OpenID Connect provider — authorize, token, userinfo, JWKS, discovery, IdP callbacks.",
        "title": "SSO Service API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/.well-known/jwks.json": {
            "get": {
                "description": "Public signing keys used to verify ID tokens.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "oidc"
                ],
                "summary": "JSON Web Key Set",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_wave-connect_sso-platform_apps_sso-service_internal_model.JWKSResponse"
                        }
                    }
                }
            }
        },
        "/.well-known/openid-configuration": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "oidc"
                ],
                "summary": "OpenID Connect discovery document",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_wave-connect_sso-platform_apps_sso-service_internal_model.OIDCDiscoveryDocument"
                        }
                    }
                }
            }
        },
        "/idp/oidc/callback": {
            "get": {
                "description": "Receives the authorization code from an external OIDC IdP, exchanges it for tokens, provisions the user via JIT, and starts an SSO session.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "oidc"
                ],
                "summary": "External OIDC IdP callback",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Authorization code returned by the IdP",
                        "name": "code",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Relay-state token previously stored in Redis",
                        "name": "state",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "302": {
                        "description": "Redirect back to the original OAuth client redirect_uri"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/github_com_wave-connect_sso-platform_apps_sso-service_internal_model.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/oauth2/authorize": {
            "get": {
                "description": "Initiates an OAuth2/OIDC authorization-code flow. May redirect to the login portal, an external IdP, or the consent screen.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "oauth2"
                ],
                "summary": "OAuth2 authorization endpoint",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Registered OAuth client ID",
                        "name": "client_id",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Must be `code`",
                        "name": "response_type",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Redirect URI registered with the client",
                        "name": "redirect_uri",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Space-separated scopes",
                        "name": "scope",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Opaque value returned to the client",
                        "name": "state",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "PKCE challenge",
                        "name": "code_challenge",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "PKCE method (S256)",
                        "name": "code_challenge_method",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "OIDC nonce",
                        "name": "nonce",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "External IdP ID for federated auth",
                        "name": "idp_hint",
                        "in": "query"
                    }
                ],
                "responses": {
                    "302": {
                        "description": "Redirect to login portal, IdP, consent, or the client's redirect_uri"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/github_com_wave-connect_sso-platform_apps_sso-service_internal_model.OAuthErrorResponse"
                        }
                    }
                }
            }
        },
        "/oauth2/consent": {
            "get": {
                "description": "Returns the client, scopes, and tenant context to be displayed on the consent screen.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "oauth2"
                ],
                "summary": "Fetch consent form data",
                "parameters": [
                    {
                        "type": "string",
                        "description": "OAuth client ID",
                        "name": "client_id",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Requested scopes",
                        "name": "scope",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Redirect URI",
                        "name": "redirect_uri",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "OAuth state",
                        "name": "state",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Pinned tenant ID",
                        "name": "tenant_id",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_wave-connect_sso-platform_apps_sso-service_internal_model.ConsentFormData"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/github_com_wave-connect_sso-platform_apps_sso-service_internal_model.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Records the user's accept/deny decision and resumes the OAuth flow.",
                "consumes": [
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "oauth2"
                ],
                "summary": "Submit a consent decision",
                "parameters": [
                    {
                        "type": "string",
                        "description": "OAuth client ID",
                        "name": "client_id",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Granted scopes",
                        "name": "scope",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Redirect URI",
                        "name": "redirect_uri",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "OAuth state",
                        "name": "state",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Pinned tenant ID",
                        "name": "tenant_id",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "`accept` or `deny`",
                        "name": "decision",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "302": {
                        "description": "Redirect to OAuth client or login"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/github_com_wave-connect_sso-platform_apps_sso-service_internal_model.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/oauth2/token": {
            "post": {
                "description": "Exchange an authorization code or refresh token for access/refresh/ID tokens.",
                "consumes": [
                    "application/x-www-form-urlencoded"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "oauth2"
                ],
                "summary": "OAuth2 token endpoint",
                "parameters": [
                    {
                        "type": "string",
                        "description": "authorization_code or refresh_token",
                        "name": "grant_type",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Authorization code (authorization_code grant)",
                        "name": "code",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "Redirect URI used in /authorize",
                        "name": "redirect_uri",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "OAuth client ID (or via Basic auth)",
                        "name": "client_id",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "OAuth client secret (or via Basic auth)",
                        "name": "client_secret",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "Refresh token (refresh_token grant)",
                        "name": "refresh_token",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "PKCE verifier",
                        "name": "code_verifier",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_wave-connect_sso-platform_apps_sso-service_internal_model.TokenResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/github_com_wave-connect_sso-platform_apps_sso-service_internal_model.OAuthErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/github_com_wave-connect_sso-platform_apps_sso-service_internal_model.OAuthErrorResponse"
                        }
                    }
                }
            }
        },
        "/userinfo": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "OIDC UserInfo endpoint — returns claims for the bearer access token.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "oidc"
                ],
                "summary": "UserInfo endpoint",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Tenant ID required to decrypt the token",
                        "name": "X-Tenant-ID",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_wave-connect_sso-platform_apps_sso-service_internal_model.UserInfoResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/github_com_wave-connect_sso-platform_apps_sso-service_internal_model.OAuthErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "github_com_wave-connect_sso-platform_apps_sso-service_internal_model.ConsentFormData": {
            "type": "object",
            "properties": {
                "client_id": {
                    "type": "string"
                },
                "client_name": {
                    "type": "string"
                },
                "redirect_uri": {
                    "type": "string"
                },
                "requested_scopes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "state": {
                    "type": "string"
                },
                "tenant_id": {
                    "description": "TenantID is the tenant the OAuth2 flow was pinned to at first\n/authorize touch (Phase 5). The consent UI must echo this back in\nthe POST body so the code is minted for the same tenant, not the\nsession's current active_tenant_id (which may have drifted if the\nuser switched tenants mid-flow).",
                    "type": "string"
                }
            }
        },
        "github_com_wave-connect_sso-platform_apps_sso-service_internal_model.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "server_error"
                }
            }
        },
        "github_com_wave-connect_sso-platform_apps_sso-service_internal_model.JWKSResponse": {
            "type": "object",
            "properties": {
                "keys": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": {}
                    }
                }
            }
        },
        "github_com_wave-connect_sso-platform_apps_sso-service_internal_model.OAuthErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "invalid_grant"
                },
                "error_description": {
                    "type": "string"
                }
            }
        },
        "github_com_wave-connect_sso-platform_apps_sso-service_internal_model.OIDCDiscoveryDocument": {
            "type": "object",
            "properties": {
                "authorization_endpoint": {
                    "type": "string"
                },
                "id_token_signing_alg_values_supported": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "issuer": {
                    "type": "string"
                },
                "jwks_uri": {
                    "type": "string"
                },
                "response_types_supported": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "scopes_supported": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "subject_types_supported": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "token_endpoint": {
                    "type": "string"
                },
                "token_endpoint_auth_methods_supported": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "userinfo_endpoint": {
                    "type": "string"
                }
            }
        },
        "github_com_wave-connect_sso-platform_apps_sso-service_internal_model.TokenResponse": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string"
                },
                "expires_in": {
                    "type": "integer"
                },
                "id_token": {
                    "type": "string"
                },
                "refresh_token": {
                    "type": "string"
                },
                "scope": {
                    "type": "string"
                },
                "token_type": {
                    "type": "string"
                }
            }
        },
        "github_com_wave-connect_sso-platform_apps_sso-service_internal_model.UserInfoResponse": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "email_verified": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "picture": {
                    "type": "string"
                },
                "preferred_username": {
                    "type": "string"
                },
                "sub": {
                    "type": "string"
                },
                "tenant_id": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}