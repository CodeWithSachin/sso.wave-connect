{
  "name": "@sso-platform/developer-portal-api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "developer-portal-api",
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": { "command": "webpack-cli build", "args": ["--node-env=production"], "cwd": "apps/developer-portal-api" },
        "configurations": { "development": { "args": ["--node-env=development"] } }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": ["build"],
        "options": { "buildTarget": "developer-portal-api:build", "runBuildTargetDependencies": false },
        "configurations": {
          "development": { "buildTarget": "developer-portal-api:build:development" },
          "production": { "buildTarget": "developer-portal-api:build:production" }
        }
      }
    },
    "tags": ["scope:developer", "type:api"]
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0", "@nestjs/core": "^11.0.0", "@nestjs/platform-express": "^11.0.0",
    "@sso-platform/nestjs-auth": "workspace:*",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.1.13", "rxjs": "^7.8.0", "tslib": "^2.3.0"
  },
  "devDependencies": { "@nestjs/testing": "^11.0.0" }
}
