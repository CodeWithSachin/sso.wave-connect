<!doctype html>
<html lang="en">
<head>
  <title>WaveConnect API Reference</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="data:," />
  <style>
    body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  </style>
</head>
<body>
  <!--
    Scalar API Reference — unified portal.

    All sources are RELATIVE paths into ./specs/ and ./grpc/. The bundle is
    self-hosted at ./scalar/standalone.js. The build script writes both at
    deploy time from `docs/api/<svc>/openapi.json` (committed) — no runtime
    dependency on services being reachable, no CORS coupling, no CDN.

    Scalar 1.57+ requires an explicit `Scalar.createApiReference(mount, cfg)`
    init call; the legacy `<script id="api-reference" type="application/json">`
    config block is no longer auto-detected.
  -->
  <div id="app"></div>
  <script src="__SCALAR_BUNDLE__"></script>
  <script>
    Scalar.createApiReference('#app', __SOURCES_JSON__);
  </script>
</body>
</html>
