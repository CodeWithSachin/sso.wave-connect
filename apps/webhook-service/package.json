{
  "name": "@sso-platform/webhook-service",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "webhook-service",
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": ["--node-env=production"],
          "cwd": "apps/webhook-service"
        },
        "configurations": {
          "development": { "args": ["--node-env=development"] }
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": ["build"],
        "options": { "buildTarget": "webhook-service:build", "runBuildTargetDependencies": false },
        "configurations": {
          "development": { "buildTarget": "webhook-service:build:development" },
          "production": { "buildTarget": "webhook-service:build:production" }
        }
      }
    },
    "tags": ["scope:webhook", "type:api"]
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@sso-platform/nestjs-auth": "workspace:*",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": { "@nestjs/testing": "^11.0.0" }
}
