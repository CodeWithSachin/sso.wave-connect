# Wave Connect — site env vars.
#
# Copy to `.env` for local overrides; never commit `.env`. Only vars with
# the `PUBLIC_` prefix are exposed to the client and baked into the
# static HTML. Anything without the prefix stays server-only and won't
# leak into the bundle (irrelevant for this static site, but keep the
# convention in case we add SSR later).

# Origin of this site. Used by the link helper to decide whether a URL
# is same-origin (defaults to localhost during dev).
PUBLIC_SITE_URL=https://wave-connect.com

# Cross-app destinations. In dev these point at the workspace ports;
# prod values should be the deployed subdomains / paths.
PUBLIC_LOGIN_PORTAL_URL=https://login.wave-connect.com
PUBLIC_ADMIN_CONSOLE_URL=https://app.wave-connect.com
PUBLIC_DEVELOPER_PORTAL_URL=https://developers.wave-connect.com

# External destinations.
PUBLIC_STATUS_URL=https://status.wave-connect.com
PUBLIC_CHANGELOG_URL=https://changelog.wave-connect.com
PUBLIC_GITHUB_URL=https://github.com/wave-connect
PUBLIC_TWITTER_URL=https://twitter.com/waveconnect
