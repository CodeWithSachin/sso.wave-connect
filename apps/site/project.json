{
  "name": "site",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/site/src",
  "tags": ["scope:marketing", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/site"],
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "command": "pnpm exec astro build",
        "cwd": "apps/site"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec astro dev --port 4400 --host",
        "cwd": "apps/site"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "pnpm exec astro preview --port 4400 --host",
        "cwd": "apps/site"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "pnpm exec astro check",
        "cwd": "apps/site"
      }
    }
  }
}
