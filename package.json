{
  "name": "@sso-platform/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "lint:all": "pnpm nx run-many --target=lint --all",
    "test:all": "pnpm nx run-many --target=test --all",
    "build:all": "pnpm nx run-many --target=build --all",
    "serve:all": "export $(grep -v '^#' .env | xargs) && pnpm nx run-many --target=serve --projects=admin-console,developer-portal,login-portal,api-docs,admin-api,developer-portal-api,audit-service,webhook-service,directory-service,sso-service,identity-service,authz-service --parallel=12",
    "serve:frontend": "pnpm nx run-many --target=serve --projects=admin-console,developer-portal,login-portal,api-docs --parallel=4",
    "serve:backend": "export $(grep -v '^#' .env | xargs) && pnpm nx run-many --target=serve --projects=admin-api,developer-portal-api,audit-service,webhook-service,directory-service,sso-service,identity-service,authz-service --parallel=8",
    "docs:export": "pnpm nx run-many --target=openapi:export --projects=admin-api,audit-service,developer-portal-api,directory-service,webhook-service,identity-service,authz-service,sso-service",
    "docs:build": "pnpm docs:export && pnpm nx build api-docs",
    "docs:serve": "pnpm nx serve api-docs",
    "docs:check": "scripts/check-grpc-spec-drift.sh"
  },
  "private": true,
  "devDependencies": {
