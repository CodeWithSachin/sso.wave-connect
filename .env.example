# Copy to .env and fill in values for local development.
#   cp .env.example .env
#   openssl rand -base64 32  # for OIDC_SECRET_KEY below

# ---- Infrastructure (Docker compose: infra/docker/docker-compose.yml) ----

# PostgreSQL on port 5433 (separate from any host Postgres on 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/sso_dev?schema=public"

REDIS_URL="redis://localhost:6379"
NATS_URL="nats://localhost:4222"

# OpenFGA (start with infra; bootstrap a store once per environment)
OPENFGA_API_URL="http://localhost:8080"
OPENFGA_GRPC_URL="localhost:8081"
# Run ./openfga/scripts/bootstrap.sh once, then paste the resolved id here.
# authz-service refuses to boot without this.
OPENFGA_STORE_ID=

# ---- admin-api (NestJS, port 3100) ----

# 'console' (dev — logs emails to stdout) or 'ses' (production SES transport)
EMAIL_PROVIDER=console

# Port admin-api binds to. Default 3100.
ADMIN_API_PORT=3100

# Base URL of login-portal — used in invitation emails so the link lands the
# recipient on the correct accept/decline page.
INVITATION_LINK_BASE_URL=http://localhost:4300

# admin-api session-bootstrap calls this for fresh-cookie validation.
IDENTITY_SERVICE_URL=http://localhost:3000

# AES-256-GCM key for envelope-encrypting OIDC client secrets at rest.
#   - 32 raw bytes, base64-encoded (openssl rand -base64 32)
#   - admin-api throws on boot if missing or wrong length
#   - sso-service reads the SAME value in Milestone A Slice 2 to decrypt;
#     deploy them with a shared secret reference, not two copies
#   - Production: the env var is populated by Kubernetes from a Secret
#     manifest backed by AWS KMS or Vault dynamic secrets — never commit
#     real values, and never let the value appear in logs or transcripts
OIDC_SECRET_KEY=
