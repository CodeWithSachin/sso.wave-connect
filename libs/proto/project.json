{
  "name": "proto",
  "projectType": "library",
  "sourceRoot": "libs/proto",
  "tags": ["scope:shared", "type:proto"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/proto",
