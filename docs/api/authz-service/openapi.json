                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "authz"
                ],
                "summary": "Batch check permissions",
                "parameters": [
                    {
                        "description": "Batch check",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
