                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/github_com_wave-connect_sso-platform_apps_authz-service_internal_model.BatchCheckResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/github_com_wave-connect_sso-platform_apps_authz-service_internal_model.ErrorResponse"
